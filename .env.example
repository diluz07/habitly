# Copy this file to .env and fill it in. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27017/habitly
JWT_SECRET=change-me-to-a-long-random-string
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key
# llama-3.3-70b-versatile = better quality; llama-3.1-8b-instant = higher free daily limits
GROQ_MODEL=llama-3.3-70b-versatile
PORT=3000

# Brevo Email Configuration (Free 300 emails/day to any recipient)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Habitly

# Optional: Resend API Key (alternative email provider)
RESEND_API_KEY=
EMAIL_FROM=Habitly <onboarding@resend.dev>
