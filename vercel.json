{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/signup", "destination": "/login.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ]
}
